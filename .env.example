# Salin file ini menjadi .env lalu isi nilainya.

# String koneksi PostgreSQL (Supabase: Settings → Database → Connection String → URI).
# Wajib untuk login/registrasi UMKM, akun pemerintah, dan catatan intervensi.
DATABASE_URL=

# WAJIB. Kunci penandatangan token login (JWT): string acak minimal 32 karakter,
# misalnya hasil `openssl rand -hex 32`. Server tidak mau berjalan tanpa ini.
# Jangan pernah dibagikan atau di-commit.
JWT_SECRET=

# Google Gemini untuk fitur Solusi Olahan (AI).
GEMINI_API_KEY=
GEMINI_MODEL=

# Port server Go (opsional, bawaan 8080).
PORT=
